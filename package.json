{
  "name": "cineverse",
  "version": "1.0.0",
  "private": true,
  "description": "CineVerse — a premium private cinema for two. Perfectly synced playback, live chat, and calls.",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/unit-tests.mjs",
    "validate:youtube-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-youtube-catalog.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:browser:direct": "node scripts/browser/run-direct.mjs",
    "test:browser:direct:stress": "node scripts/browser/run-direct.mjs --stress",
    "test:e2e:stress": "node scripts/e2e-stress.mjs",
    "test:soak": "node scripts/soak.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "handoff": "node scripts/make-handoff.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "clsx": "2.1.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.454.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  }
}
