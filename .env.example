# CineVerse configuration
#
# Every value here is optional — the app runs with no configuration at all.
# Copy this file to `.env.local` and fill in only what you need.

# Port the server binds to. Most hosting platforms set this for you.
PORT=3000

# Interface to bind. Default 0.0.0.0 (all interfaces), which is what a container
# or PaaS needs. Use 127.0.0.1 to keep the server local to this machine.
# HOST=0.0.0.0

# Everything here is validated at startup (server/config.js). In production an
# invalid value REFUSES to boot rather than falling back silently — a partially
# configured bucket that quietly writes to local disk loses uploads on the next
# redeploy, and nobody finds out until someone asks where their film went.
# In development the same problems are printed as warnings and the server runs.

# Absolute URL of the deployment. Used for Open Graph / social preview metadata.
# Example: https://cineverse.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Abuse throttling + chat memory bounds
#
# Per-event rate limits live in code (server/rate-limit.js) — they are tuned to
# the app's real event cadence and are not individually configurable. Only the
# genuinely operational values are exposed here.
# ---------------------------------------------------------------------------

# Trust `x-forwarded-for` when keying rate limits by IP. OFF by default: the
# header is client-controlled, so trusting it blindly would let a flooder mint
# unlimited IP keys. Set to 1 ONLY when running behind a proxy you control that
# always overwrites this header (e.g. Render, Cloudflare).
RATE_LIMIT_TRUST_PROXY=0

# Largest single chat attachment, in DECODED bytes. Default 8 MiB.
# (An encoded-length ceiling is enforced too, as defence in depth.)
CHAT_ATTACHMENT_MAX_BYTES=8388608

# Total in-memory budget for one room's chat history. Oldest messages are
# evicted once either this or the 200-message cap is exceeded. Default 24 MiB.
CHAT_HISTORY_MAX_BYTES=25165824

# The Socket.IO frame limit is DERIVED from CHAT_ATTACHMENT_MAX_BYTES, not set
# here — see realtimeMaxBufferBytes() in server/chat-limits.js. Writing it down
# twice is how a valid attachment ends up dropped by the transport before any
# handler can answer it.

# ---------------------------------------------------------------------------
# Room lifecycle
# ---------------------------------------------------------------------------

# How long a member who drops keeps their seat, so a refresh reclaims it
# silently instead of churning presence. Default 30000 (30s). 0 disables grace.
# ROOM_RECONNECT_GRACE_MS=30000

# How long an empty room lingers before it is reaped. Default 900000 (15 min).
# Exposed so the soak test can prove reaping happens without waiting; there is
# no reason to change it in production.
# ROOM_EMPTY_TTL_MS=900000

# Adds heap/bucket counters to /healthz. Off by default — operational detail,
# not something every deployment should publish. Used by `npm run test:soak`.
# EXPOSE_PROCESS_METRICS=0

# ---------------------------------------------------------------------------
# Test-harness knobs (never set these in a real deployment)
# ---------------------------------------------------------------------------
# Write a machine-readable realtime-E2E result to this path. Written for success
# and failure, atomically, with tokens/seat ids/SDP/attachments scrubbed.
# E2E_RESULT_FILE=/tmp/e2e-result.json
# Cold-stress iterations, and whether to keep going past the first failure to
# measure how often it happens. See `npm run test:e2e:stress`.
# E2E_ITERATIONS=20
# E2E_CONTINUE_AFTER_FAILURE=0

# ---------------------------------------------------------------------------
# WebRTC ICE servers (voice/video calls)
#
# A JSON array of RTCIceServer entries, exposed to the browser. Invalid JSON,
# a non-array, or an empty array falls back to built-in public STUN.
#
# STUN alone is enough on many networks, but symmetric NAT and most mobile
# carriers need a TURN relay for calls to connect reliably in production.
# ---------------------------------------------------------------------------
# STUN only (this is also the built-in default):
# NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# With a TURN server (recommended for production):
# NEXT_PUBLIC_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"USER","credential":"PASS"}]

# ---------------------------------------------------------------------------
# Shared uploads for local video files (see docs/uploads.md)
#
# With NOTHING set below, uploads are written to a local ./.uploads directory.
# That works out of the box for development, but it is NOT production storage:
# an ephemeral host loses the disk on every restart.
#
# TWO transports, chosen by the SERVER per file:
#   single    one request, browser -> bucket (presigned POST) or -> this server
#             (dev filesystem). Capped at 500 MiB and NOT resumable.
#   multipart independent 16 MiB slices, browser -> bucket, resumable, up to
#             3 GiB. Requires complete object storage AND a stable UPLOAD_SECRET.
#
# 3 GiB is enabled by explicit configuration on a deployment with object storage.
# The code default stays 500 MiB so an existing deployment without a bucket keeps
# booting and keeps behaving exactly as it did.
# ---------------------------------------------------------------------------

# Largest single upload, in bytes. Default 500MB (524288000).
#
# For a deployment WITH object storage, the recommended production value is
# 3 GiB. Above 500 MiB this REQUIRES a complete S3 block — the dev filesystem
# adapter is capped at 500 MiB by a hard ceiling no variable can raise, because
# streaming gigabytes through Node is the architecture this design avoids.
MAX_UPLOAD_BYTES=524288000
# MAX_UPLOAD_BYTES=3221225472   # 3 GiB — needs the S3 block below

# Signing secret for upload capability tokens. Random per boot when unset, which
# is fine for single-shot uploads on one process.
#
# REQUIRED, stable, and at least 32 bytes for large uploads: a multipart session
# lives up to six hours and its token is the ONLY thing that can resume it, so a
# per-boot secret makes an in-flight 3 GB upload unresumable across a deploy.
# Multipart stays disabled until this is set strongly.
# UPLOAD_SECRET=

# How long uploaded files are kept. Only used by the dev filesystem sweeper —
# object storage should expire objects with a bucket lifecycle rule instead.
# UPLOAD_TTL_HOURS=6

# Where the dev filesystem adapter writes. Default ./.uploads
# UPLOAD_DIR=

# Lower the dev filesystem ceiling below the global maximum. It can only ever
# LOWER it: the hard local ceiling is 500 MiB regardless of what is set here.
# LOCAL_UPLOAD_MAX_BYTES=

# --- Resumable multipart uploads ---------------------------------------------
# Only consulted when object storage is configured. Every value is validated at
# startup; production refuses to boot on an invalid one.

# Bytes per part. Range 8–64 MiB. Default 16 MiB (16777216).
# 3 GiB / 16 MiB = 192 parts, well inside the provider's 10,000-part limit.
# UPLOAD_PART_SIZE_BYTES=16777216

# Parts uploaded at once by one browser. Range 1–6. Default 3.
# This is what bounds browser memory: partSize x concurrency (~48 MiB at the
# defaults), regardless of whether the file is 100 MB or 3 GB.
# UPLOAD_PART_CONCURRENCY=3

# Retries per part before the upload fails. Range 0–10. Default 5.
# UPLOAD_PART_RETRIES=5

# Session lifetime, in seconds. Range 900–86400. Default 21600 (6h).
# A 3 GiB upload on a slow line takes hours; the client renews near expiry.
# UPLOAD_SESSION_TTL_SECONDS=21600

# Absolute session lifetime, in seconds. Range 900–259200. Default 86400 (24h).
# The IMMUTABLE ceiling a renewal loop can never pass: fixed when the intent is
# created, re-signed unchanged on every renewal. Must be >= UPLOAD_SESSION_TTL_
# SECONDS. Once reached, upload:renew returns SESSION_EXPIRED with no new token.
# UPLOAD_SESSION_MAX_LIFETIME_SECONDS=86400

# Presigned part-URL lifetime, in seconds. Range 60–3600. Default 900 (15 min).
# Short on purpose: each URL is a write capability, and the client re-signs the
# parts it is about to send rather than holding all 192 at once.
# UPLOAD_PART_URL_TTL_SECONDS=900

# Concurrent multipart uploads allowed. Defaults: 1 per member, 2 per room.
# A second upload from the same member is REFUSED (UPLOAD_ALREADY_ACTIVE) rather
# than silently orphaning the first.
# UPLOAD_MAX_ACTIVE_PER_MEMBER=1
# UPLOAD_MAX_ACTIVE_PER_ROOM=2

# --- S3-compatible object storage (Cloudflare R2, AWS S3, Supabase, MinIO) ---
# Set all four to switch off the dev filesystem adapter and upload directly
# from the browser to the bucket. Credentials stay server-side; the browser only
# ever sees opaque, expiring URLs.
#
# A PARTIAL block is always a startup error, in every environment — quietly
# falling back to local disk loses every upload on the next redeploy.
#
# The bucket needs CORS that allows POST/PUT/GET/HEAD from this origin and
# EXPOSES the ETag header. Without exposed ETags a multipart part upload cannot
# be acknowledged and the upload fails with MISSING_ETAG. See docs/uploads.md.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=cineverse-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Path-style URLs (<endpoint>/<bucket>/<key>). Default on; R2 and MinIO need it.
# S3_FORCE_PATH_STYLE=1
# Serve reads through a CDN/custom domain instead of a presigned GET.
# The bucket must then be public-read. Leave unset to keep the bucket private.
# S3_PUBLIC_BASE_URL=
# Lifetime of a presigned read URL, in seconds. Default 21600 (6h).
# A room session longer than this outlives its read URL — see the caveat in
# docs/uploads.md.
# UPLOAD_READ_TTL_SECONDS=21600
